# Copy to .env and fill in. Never commit .env.

# Moonetix dashboard: API page. Server only, never in the game.
MOONETIX_API_KEY=test_api_key_not_secret
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=test_postback_key_not_secret

# Optional
PORT=3000
DATABASE_PATH=./data.sqlite
CURRENCY_NAME=Coins
